  "description": "Visual retro game maker for PC Engine / TurboGrafx-16",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "cross-env NO_TYPE_CHECKING=1 electron-forge start",
    "package": "cross-env NODE_ENV=production NO_TYPE_CHECKING=1 electron-forge package",
    "make:win": "cross-env NODE_ENV=production NO_TYPE_CHECKING=1 electron-forge make --arch=x64 --platform=win32",
    "make:win32": "cross-env NODE_ENV=production NO_TYPE_CHECKING=1 electron-forge make --arch=ia32 --platform=win32",
    "make": "cross-env NODE_ENV=production NO_TYPE_CHECKING=1 electron-forge make",
    "build:pce": "node scripts/build-pce.js"
  },
  "keywords": [
    "pce",
    "pcengine",
    "turbografx16",
    "huc",
    "nex",
    "pceas",
    "game-maker"
  ],
  "author": "Alx5962",
  "license": "MIT",
  "config": {
